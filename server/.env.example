# Environment Variables

# HubSpot Configuration
# Set to 'true' to use mock mode (no real API calls)
HUBSPOT_MOCK_MODE=false

# HubSpot Private App Access Token
# Get this from: HubSpot Settings > Integrations > Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.deals.read, crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN=xxx-xxx-xxxxx

# Zoom Configuration
# Set to 'true' to use mock mode (no real API calls)
ZOOM_MOCK_MODE=false

# Zoom Server-to-Server OAuth Credentials
# Get these from: Zoom Marketplace > Develop > Build App > Server-to-Server OAuth
# Required scopes: meeting:write, user:read
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Server Configuration (Optional)
PORT=3000
NODE_ENV=development
